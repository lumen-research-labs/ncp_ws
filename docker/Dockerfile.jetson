# Robot container: Jetson Orin Nano Super, ROS2 Humble, TensorRT, ONNX Runtime.
#
# Built ON THE ROBOT only. Never cross-compiled from the workstation.
#
# TODO(phase1): pin to the L4T release actually on the unit —
#   ssh robot 'cat /etc/nv_tegra_release'
# and set the tag below to the matching dustynv/l4t image. A mismatch against
# the host driver fails at runtime, not at build time.
ARG L4T_TAG=TODO_PHASE1
FROM dustynv/ros:humble-desktop-l4t-r${L4T_TAG}

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DOMAIN_ID=42

# TODO(phase1): ONNX Runtime GPU build matching the JetPack version. The pip
# wheel is not the right one on Jetson — use the NVIDIA-provided wheel.

WORKDIR /ws
CMD ["bash"]
