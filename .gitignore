# ROS2 / colcon
build/
install/
log/

# Never commit TensorRT engines — they are built on the target device
*.engine
*.plan

# Bags: only trimmed fixtures under tests/fixtures/ are committed
*.db3
*.mcap
!tests/fixtures/**/*.db3
!tests/fixtures/**/*.mcap

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/

# Claude Code machine-local settings
.claude/settings.local.json
# Subagent working memory. NOT ignored: the rm-safety-reviewer patterns are
# accumulated project knowledge about THIS codebase — which invariants hold by
# construction, and what to re-check when a given area is edited. That belongs
# with the code and is part of what a new maintainer inherits.

# Claude Code worktrees — transient, never part of the repo
.claude/worktrees/
