<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rm_interfaces</name>
  <version>0.0.0</version>
  <description>
    Custom message and service definitions for the ROSMASTER X3 policy
    pipeline, plus the shared interface.yaml schema loader. Built on both the
    robot and the workstation.
  </description>
  <maintainer email="devsp2003@gmail.com">Dev Patel</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- rosidl_default_generators is a build-time code-generation dep, not a
       build-tool. Listing it as build_depend is the ROS2 Humble convention. -->
  <build_depend>rosidl_default_generators</build_depend>

  <!-- std_msgs provides std_msgs/Header, used in SafetyStatus.msg.
       builtin_interfaces provides builtin_interfaces/Time used transitively. -->
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>

  <!-- geometry_msgs provides geometry_msgs/Twist, used in BaseDebug.msg to
       echo back the /cmd_vel that rm_base last received. -->
  <depend>geometry_msgs</depend>

  <!-- Kill (/safety/kill) and reset (/safety/reset) use std_srvs/srv/Trigger.
       That is a no-argument, success+message service — exactly the right shape
       and idiomatic ROS2. rm_interfaces therefore ships NO custom srv for
       kill/reset. The std_srvs dependency belongs to rm_safety (the node that
       advertises those services), not to this interface package. -->
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
