<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rm_dashboard</name>
  <version>0.0.0</version>
  <description>
    ROBOT. Read-mostly web dashboard for the NCP pipeline: serves a live view
    of scan, observation, policy action, safety state and per-wheel base
    telemetry over plain HTTP + SSE. Publishes NO topics ever; its only
    outbound effects are /safety/kill, /safety/reset and parameter sets.
  </description>
  <maintainer email="devsp2003@gmail.com">Dev Patel</maintainer>
  <license>Proprietary</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>rcl_interfaces</depend>
  <depend>rm_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
