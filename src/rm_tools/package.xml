<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rm_tools</name>
  <version>0.0.0</version>
  <description>
    WORKSTATION ONLY. Offline bag analysis, model export, schema checking. Never a runtime dependency of rm_safety or rm_policy.
  </description>
  <maintainer email="devsp2003@gmail.com">Dev Patel</maintainer>
  <license>Proprietary</license>

  <depend>rclpy</depend>
  <depend>rosbag2_py</depend>
  <depend>rm_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
